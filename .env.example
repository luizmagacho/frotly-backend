NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/gestor-frota-pr

# JWT
JWT_SECRET=gestor-frota-pr-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# SMTP (E-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@gestorfrota.com.br

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Admin alerts recipient
ADMIN_EMAIL=admin@gestorfrota.com.br
ADMIN_PHONE=41999990000

# Frontend
FRONTEND_URL=http://localhost:3000

# ─── Detran PR - Frotista API ──────────────────────────────────────────────
# URL de autenticação OAuth2
DETRAN_AUTH_URL=https://auth-cs.identidadedigital.pr.gov.br/centralautenticacao/api/v1/token/jwt
# URL base da API Gateway
DETRAN_API_URL=https://apigateway.paas.pr.gov.br/detran/frotista/api/v1
# Credenciais (Client_Id e Client_Secret) fornecidas pelo Detran/PR após credenciamento
DETRAN_CLIENT_ID=
DETRAN_CLIENT_SECRET=

# ─── Inteligência Artificial (Kivoni / Groq) ─────────────────────────────────
# Provedor do LLM (groq, together, deepinfra, openrouter)
LLM_PROVIDER=groq
LLM_API_KEY=sua-chave-aqui
LLM_MODEL=llama-3.3-70b-versatile

# ─── Seed scripts (seed-admin.js / seed-local-users.js) ─────────────────────
# Not read by the app itself — only by the manual seed scripts in this folder.
# Named SEED_* (not ADMIN_EMAIL/ADMIN_PASSWORD) to avoid colliding with the
# ADMIN_EMAIL above, which notifications.service.ts reads as the alert recipient.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
MONGODB_ATLAS_URI=
SEED_USER_1_EMAIL=
SEED_USER_1_PASSWORD=
SEED_USER_1_NAME=
SEED_USER_2_EMAIL=
SEED_USER_2_PASSWORD=
SEED_USER_2_NAME=

# ─── Stripe billing ──────────────────────────────────────────────────────────
# Get these from your Stripe dashboard (test mode keys start with sk_test_/whsec_test_).
# Run `npx ts-node scripts/stripe-setup.ts` (with STRIPE_SECRET_KEY set) to create the
# products/prices and print the STRIPE_PRICE_* values below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
